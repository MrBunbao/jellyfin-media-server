# YAMS API Testing Configuration
# Copy this file to .env and fill in your values

# Jellyfin
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Sonarr
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here

# Scheduled Health Check (US-010)
# Cron expression for audit schedule (default: Sunday 03:00)
AUDIT_SCHEDULE=0 3 * * 0
# Optional webhook URL for notifications (Discord/Slack-compatible)
AUDIT_WEBHOOK_URL=
# Run audit immediately on container startup (default: true)
AUDIT_RUN_ON_START=true
